      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kapalıyken devam et"
          }
        }
      }
    },
    "Right now Waymark only sees your location while the app is open. Allow “Always” so it can still tell you when you enter a new place with your phone in your pocket. Your location never leaves your device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an Waymark konumunu yalnızca uygulama açıkken görüyor. “Her zaman” izni verirsen, telefonun cebindeyken de yeni bir yere girdiğinde sana haber verebilir. Konum bilgin cihazından hiçbir yere gönderilmez."
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi değil"
          }
        }
